<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EnhancedSpectator</AssemblyName>
    <Version>0.3.5</Version>
    <RootNamespace>EnhancedSpectator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Lethal Company</GameDir>
    <MoreCompanyPath Condition="'$(MoreCompanyPath)' == ''">D:\1New R2modman\LethalCompany\profiles\test5\BepInEx\plugins\notnotnotswipez-MoreCompany\MoreCompany.dll</MoreCompanyPath>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Lethal Company_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.7.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GameInterop\V81DropshipLayout.json" />
    <EmbeddedResource Include="GameInterop\V81DropshipAudio.json" />
    <EmbeddedResource Include="Resources\nativefade.bundle" />
    <InternalsVisibleTo Include="EnhancedSpectator.Tests" />
    <!-- HDRP renderer-list ABI must match V81's installed Unity, not the old 2021 stubs. -->
    <Reference Include="$(ManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="MoreCompany" HintPath="$(MoreCompanyPath)" Private="false" />
    <Reference Include="Unity.Animation.Rigging" HintPath="$(ManagedDir)\Unity.Animation.Rigging.dll" Private="false" />
    <Reference Include="Assembly-CSharp"
               HintPath="$(ManagedDir)\Assembly-CSharp.dll"
               Private="false"
               Publicize="true"
               Condition="Exists('$(ManagedDir)\Assembly-CSharp.dll')" />
    <Reference Include="Unity.Netcode.Runtime"
               HintPath="$(ManagedDir)\Unity.Netcode.Runtime.dll"
               Publicize="true"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.Netcode.Runtime.dll')" />
    <Reference Include="Unity.Collections"
               HintPath="$(ManagedDir)\Unity.Collections.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.Collections.dll')" />
    <Reference Include="Unity.InputSystem"
               HintPath="$(ManagedDir)\Unity.InputSystem.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.InputSystem.dll')" />
    <Reference Include="UnityEngine.UI"
               HintPath="$(ManagedDir)\UnityEngine.UI.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\UnityEngine.UI.dll')" />
    <Reference Include="Unity.TextMeshPro"
               HintPath="$(ManagedDir)\Unity.TextMeshPro.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.TextMeshPro.dll')" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime"
               HintPath="$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll')" />
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"
               HintPath="$(ManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll')" />
    <Reference Include="DissonanceVoip"
               HintPath="$(ManagedDir)\DissonanceVoip.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\DissonanceVoip.dll')" />
    <Reference Include="Facepunch.Steamworks.Win64"
               HintPath="$(ManagedDir)\Facepunch.Steamworks.Win64.dll"
               Private="false"
               Condition="Exists('$(ManagedDir)\Facepunch.Steamworks.Win64.dll')" />
  </ItemGroup>

  <Target Name="CheckOptionalAdapterBuildReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MoreCompanyPath)')" Text="Building the optional MoreCompany adapter requires a local MoreCompany.dll. Set -p:MoreCompanyPath to that file. Do not redistribute it with this plugin." />
  </Target>
</Project>
