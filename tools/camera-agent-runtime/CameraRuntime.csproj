<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EnhancedSpectator.CameraRuntime</AssemblyName>
    <Version>2.9.7</Version>
    <RootNamespace>EnhancedSpectator.CameraRuntime.Cinemachine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ManagedDir Condition="'$(ManagedDir)' == ''">D:\Steam\steamapps\common\Lethal Company\Lethal Company_Data\Managed</ManagedDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\libs\camera-agent\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>UNITY_2019_2_OR_NEWER;UNITY_2019_3_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2020_2_OR_NEWER;UNITY_2021_1_OR_NEWER;UNITY_2021_2_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_2022_2_OR_NEWER;UNITY_2022_3_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\libs\camera-agent\sources\com.unity.cinemachine\Runtime\**\*.cs" Exclude="..\..\libs\camera-agent\sources\com.unity.cinemachine\Runtime\Timeline\**\*.cs" />
    <Reference Include="$(ManagedDir)\UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
